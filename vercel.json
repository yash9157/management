{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run docs:build",
  "outputDirectory": "docs/.vitepress/dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/source/api-project", "permanent": false },
    { "source": "/source", "destination": "/source/api-project", "permanent": false },
    { "source": "/source/", "destination": "/source/api-project", "permanent": false },
    { "source": "/source/api-generated", "destination": "/source/api-data", "permanent": false },
    { "source": "/source/angular-lockfile", "destination": "/source/angular-project", "permanent": false },
    { "source": "/source/mvc-generated", "destination": "/source/mvc-data", "permanent": false },
    { "source": "/source/mvc-vendor", "destination": "/source/mvc-views", "permanent": false }
  ]
}
